# Postgres connection string (EU-hosted instance recommended for GDPR)
DATABASE_URL="postgresql://user:password@host:5432/cirs_delphi"
# Password for the /admin area (single shared admin login, no user management)
ADMIN_PASSWORD="choose-a-strong-password"
# Random secret used to sign the admin session cookie
SESSION_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_APP_URL="https://your-domain.example"
